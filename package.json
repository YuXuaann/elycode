{
	"name": "elycode",
	"displayName": "elycode",
	"version": "1.0.2",
	"description": "a plugin for code competition",
	"license": "MIT",
	"publisher": "yuxuaan",
	"author": "yuxuaan",
	"type": "commonjs",
	"main": "./out/elycode.js",
	"readme": "README.md",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/YuXuaann/elycode"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"contributes": {
		"commands": [
			{
				"command": "elycode.hello",
				"title": "elycode: doctor",
				"shortTitle": "elycode: doctor"
			},
			{
				"command": "elycode.refresh",
				"title": "Refresh",
				"shortTitle": "Refresh",
				"icon": {
					"dark": "media/dark/refresh.svg",
					"light": "media/light/refresh.svg"
				}
			},
			{
				"command": "elycode.addContest",
				"title": "Add Contest",
				"shortTitle": "Add Contest",
				"icon": {
					"dark": "media/dark/addContest.svg",
					"light": "media/light/addContest.svg"
				}
			},
			{
				"command": "elycode.deleteContest",
				"title": "Delete Contest",
				"shortTitle": "Delete Contest",
				"icon": {
					"dark": "media/dark/delete.svg",
					"light": "media/light/delete.svg"
				}
			},
			{
				"command": "elycode.openURL",
				"title": "Open specified URL",
				"shortTitle": "Open specified URL"
			},
			{
				"command": "elycode.openSubmitPage",
				"title": "Open submit page",
				"shortTitle": "Open submit page",
				"icon": {
					"dark": "media/dark/openSubmission.svg",
					"light": "media/light/openSubmission.svg"
				}
			}
		],
		"notebooks": [
			{
				"type": "elycode.notebook",
				"displayName": "elyNote",
				"selector": [
					{
						"filenamePattern": "*.elynote"
					}
				]
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "elycode.refresh",
					"when": "view == elycode.sidebarView",
					"group": "navigation"
				},
				{
					"command": "elycode.addContest",
					"when": "view == elycode.sidebarView",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "elycode.deleteContest",
					"when": "view == elycode.sidebarView && (viewItem == Contest || viewItem == QuestionCanBeDeleted)",
					"group": "inline"
				},
				{
					"command": "elycode.openSubmitPage",
					"when": "view == elycode.sidebarView && (viewItem == Question || viewItem == QuestionCanBeDeleted)",
					"group": "inline"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "elycode",
					"title": "elycode",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"elycode": [
				{
					"id": "elycode.sidebarView",
					"type": "tree",
					"name": "",
					"icon": "media/icon.svg",
					"contextualTitle": "Package Explorer"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "elycode.sidebarView",
				"contents": "Please open a workspace first.\n[Open Workspace](command:elycode.openWorkspace)"
			}
		],
		"configuration": [
			{
				"title": "elycode",
				"properties": {
					"elycode.compiler.detectMode": {
						"order": 1,
						"type": "string",
						"enum": [
							"auto detect(gcc)",
							"custom(gcc)"
						],
						"default": "auto detect(gcc)",
						"description": "Choose whether Elycode uses the system (auto detect) or a custom path."
					},
					"elycode.compiler.customPath": {
						"order": 2,
						"type": "string",
						"default": "",
						"markdownDescription": "Path to the code compiler.(Used only when `elycode.compilerMode` is `custom`)"
					},
					"elycode.compiler.extraParams": {
						"order": 3,
						"type": "string",
						"default": "-std=c++17",
						"description": "Additional command-line parameters for the compiler."
					},
					"elycode.running.timeLimit(seconds)": {
						"order": 4,
						"type": "number",
						"default": 2,
						"description": "Maximum execution time per submission."
					},
					"elycode.running.memoryLimit(MB)": {
						"order": 5,
						"type": "number",
						"default": 256,
						"description": "Maximum memory usage per submission."
					},
					"elycode.code.templateMode": {
						"order": 6,
						"type": "string",
						"enum": [
							"auto",
							"custom"
						],
						"default": "auto",
						"description": "Choose how new *.cpp files are initialized."
					},
					"elycode.code.customTemplate": {
						"order": 7,
						"type": "string",
						"default": "",
						"markdownDescription": "Used only when `elycode.templateMode` is `custom`."
					},
					"elycode.platform.codeforces.UserName": {
						"order": 8,
						"type": "string",
						"default": "",
						"description": "Your Codeforces user name."
					},
					"elycode.platform.luogu.UserName": {
						"order": 9,
						"type": "string",
						"default": "",
						"description": "Your Luogu user name."
					},
					"elycode.platform.updateContestInfoInterval(seconds)": {
						"order": 10,
						"type": "number",
						"default": 60,
						"markdownDescription": "Interval (in seconds) for Elycode to auto refresh contest statistics."
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.19.19",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"jsdom": "^29.1.1",
		"7zip-bin": "^5.2.0"
	}
}