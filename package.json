{
	"name": "elycode",
	"displayName": "elycode",
	"version": "1.0.0",
	"description": "a plugin for code competition",
	"license": "MIT",
	"publisher": "yuxuaan",
	"author": "yuxuaan",
	"type": "commonjs",
	"main": "./out/elycode.js",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"contributes": {
		"commands": [
			{
				"command": "elycode.hello",
				"title": "elycode: doctor",
				"shortTitle": "elycode: doctor"
			},
			{
				"command": "elycode.reloadContest",
				"title": "elycode: Reload Contest",
				"shortTitle": "elycode: reload"
			}
		],
		"notebooks": [
			{
				"type": "elycode.notebook",
				"displayName": "elyNote",
				"selector": [
					{
						"filenamePattern": "*.elynote"
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "elycode",
					"title": "elycode",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"elycode": [
				{
					"id": "elycode.sidebarView",
					"type": "tree",
					"name": "",
					"icon": "media/icon.svg",
					"contextualTitle": "Package Explorer"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "elycode.sidebarView",
				"contents": "Please open a workspace first.\n[Open Workspace](command:elycode.openWorkspace)"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.19.19",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"jsdom": "^29.1.1"
	}
}