{
	"name": "elycode",
	"displayName": "elycode",
	"version": "1.0.0",
	"description": "a plugin for code competition",
	"license": "MIT",
	"publisher": "yuxuaan",
	"author": "yuxuaan",
	"type": "commonjs",
	"main": "./out/elycode.js",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"contributes": {
		"commands": [
			{
				"command": "elycode.hello",
				"title": "elycode: doctor",
				"shortTitle": "elycode: doctor"
			}
		],
		"notebooks": [
			{
				"type": "elycode.notebook",
				"displayName": "elyNote",
				"selector": [
					{
						"filenamePattern": "*.elynote"
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "elycode",
					"title": "elycode",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"elycode": [
				{
					"id": "elycode.sidebarView",
					"type": "tree",
					"name": "",
					"icon": "media/icon.svg",
					"contextualTitle": "Package Explorer"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "elycode.sidebarView",
				"contents": "Please open a workspace first.\n[Open Workspace](command:elycode.openWorkspace)"
			}
		],
		"configuration": [
			{
				"title": "elycode",
				"properties": {
					"elycode.compilerDetectMode": {
						"order": 1,
						"type": "string",
						"enum": [
							"auto detect(gcc)",
							"custom(gcc)"
						],
						"default": "auto detect(gcc)",
						"description": "Choose whether Elycode uses the system (auto detect) or a custom path."
					},
					"elycode.compilerCustomPath": {
						"order": 2,
						"type": "string",
						"default": "",
						"markdownDescription": "Path to the code compiler.(Used only when `elycode.compilerMode` is `custom`)"
					},
					"elycode.runningTimeLimit(seconds)": {
						"order": 3,
						"type": "number",
						"default": 2,
						"description": "Maximum execution time per submission."
					},
					"elycode.runningMemoryLimit(MB)": {
						"order": 4,
						"type": "number",
						"default": 256,
						"description": "Maximum memory usage per submission."
					},
					"elycode.templateMode": {
						"order": 5,
						"type": "string",
						"enum": [
							"auto",
							"custom"
						],
						"default": "auto",
						"description": "Choose how new *.cpp files are initialized."
					},
					"elycode.customTemplate": {
						"order": 6,
						"type": "string",
						"default": "",
						"markdownDescription": "Used only when `elycode.templateMode` is `custom`."
					},
					"elycode.compileExtraParams": {
						"order": 7,
						"type": "string",
						"default": "-std=c++17",
						"description": "Additional command-line parameters for the compiler."
					},
					"elycode.temporaryPath": {
						"order": 8,
						"type": "string",
						"default": "/tmp/elycode",
						"description": "Directory used to store temporary build artifacts."
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.19.19",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"jsdom": "^29.1.1"
	}
}